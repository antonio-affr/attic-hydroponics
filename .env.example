# Copy this file to .env and set real passwords. .env is git-ignored.

# Timezone for every container.
TZ=Europe/Lisbon

# Address the MQTT port is published on. 127.0.0.1 = only this machine.
# Never publish it on an internet-facing address.
MQTT_BIND_ADDRESS=127.0.0.1

# Address the Home Assistant web UI is published on. 127.0.0.1 = only this machine.
# On the Pi this becomes the Tailscale address. Never an internet-facing one.
HA_BIND_ADDRESS=127.0.0.1

# Mosquitto users. After changing them, rebuild the password file:
#   docker compose run --rm mosquitto-passwd
#   docker compose restart mosquitto
MQTT_HA_USER=homeassistant
MQTT_HA_PASSWORD=change-me
MQTT_COLLECTOR_USER=collector
MQTT_COLLECTOR_PASSWORD=change-me
